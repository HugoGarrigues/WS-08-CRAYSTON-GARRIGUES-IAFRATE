{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "description": "API NestJS du TP4 - salles et machines",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "contract:schema": "npm run build && node test/contract-schema.mjs",
    "contract:v2": "node scripts/figer-contrat.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3"
  }
}
